# TickForge Community is simulation-only by design.
TICKFORGE_HOST=127.0.0.1
TICKFORGE_PORT=5003
TICKFORGE_CONTROL_TOKEN=replace-with-at-least-32-random-characters
# Generic demonstration values. Configure these for your own simulation.
TICKFORGE_INITIAL_EQUITY=100000
TICKFORGE_POINT_VALUE=1
TICKFORGE_FEE_PER_SIDE=0
TICKFORGE_MAX_DAILY_LOSS=1000
TICKFORGE_MAX_STOP_POINTS=50
TICKFORGE_DB_PATH=data/tickforge-community.sqlite3
